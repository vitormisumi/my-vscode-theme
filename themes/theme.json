      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "scope": [
        "meta.tag.attributes",
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx"
      ],
      "settings": {
        "foreground": "#ffdd44"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#4488ff"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag.component",
        "entity.name.tag.namespace"
      ],
      "settings": {
        "foreground": "#ff8844"
      }
    },
    {
      "scope": [
        "entity.name.tag.localname",
        "entity.name.tag.local",
        "meta.tag.component entity.name",
        "support.class.component.nested"
      ],
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#ffdd44"
      }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#ffdd44"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "scope": ["string", "string punctuation.section.embedded source"],
      "settings": {
        "foreground": "#44ff44"
      }
    },
    {
      "scope": ["support.class", "support.function", "support.method"],
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#aa44ff"
      }
    },
    {
      "scope": ["entity.name.class"],
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": [
        "entity.name.tag.component.svelte",
        "entity.name.tag.svelte",
        "meta.tag.component.svelte entity.name",
        "meta.tag.svelte entity.name",
        "source.svelte entity.name.tag",
        "punctuation.definition.tag.begin.svelte + entity.name.tag",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "variable.other.object.property",
        "meta.object-literal.key",
        "variable.other.property",
        "support.variable.property",
        "meta.object.member",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "meta.member.access.ts variable",
        "meta.member.access.js variable",
        "variable.other.object",
        "meta.object-binding-pattern-variable variable"
      ],
      "settings": {
        "foreground": "#44ffdd"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff4444"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff4444"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff4444"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff4444"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "fontStyle": "italic underline",
        "background": "#ffdd44",
        "foreground": "#f0f6fc",
        "content": "^M"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#ff4444"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#ff44aa"
      }
    },
    {
      "scope": ["source.regexp", "string.regexp"],
      "settings": {
        "foreground": "#44ff44"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#44ff44"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ff8844"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "foreground": "#ff44aa"
      }
    },
    {
      "scope": "support.variable",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
